# Application
APP_NAME=Vocabulary Learning API
DEBUG=true
ENVIRONMENT=development

# Server (uvicorn binds to 0.0.0.0:8000)
HOST=0.0.0.0
PORT=8000

# Database — SQLite for local dev, PostgreSQL for production
# SQLite example:
DATABASE_URL=sqlite:///./vocabulary.db
# PostgreSQL example:
# DATABASE_URL=postgresql://user:password@localhost:5432/vocabulary_db

# JWT
SECRET_KEY=change-me-to-a-long-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS (comma-separated origins; use * only in development)
CORS_ORIGINS=http://localhost,http://127.0.0.1,http://10.0.2.2:8000
